# DODO Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=dodo_dev_secret_key_change_in_production_min_32_chars

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=dodo_db
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Ollama / Local AI Inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120
DEFAULT_GENERAL_MODEL=qwen2.5:7b
DEFAULT_CODING_MODEL=qwen2.5-coder:7b
DEFAULT_REASONING_MODEL=deepseek-r1:8b
DEFAULT_LIGHTWEIGHT_MODEL=llama3.2:1b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text

# Local Agent Configuration
LOCAL_AGENT_PORT=8001
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_SECRET_TOKEN=dodo_local_agent_shared_secure_token_v1
AUTHORIZED_WORKSPACE_DIR=D:\DODO\workspace

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_LOCAL_AGENT_WS_URL=ws://localhost:8001/ws

